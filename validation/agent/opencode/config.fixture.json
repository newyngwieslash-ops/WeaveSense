{
  "$schema": "https://opencode.ai/config.json",
  "model": "probe/fixture",
  "small_model": "probe/fixture",
  "enabled_providers": ["probe"],
  "plugin": [],
  "share": "disabled",
  "autoupdate": false,
  "compaction": { "auto": false, "prune": false },
  "permission": { "*": "deny", "corpus_search": "allow", "corpus_get_item": "allow", "skill": { "*": "deny", "industry-analysis": "allow", "cross-source-check": "allow" } },
  "default_agent": "research",
  "agent": {
    "research": { "mode": "primary", "prompt": "Research only the approved corpus. Use corpus_search. Return structured JSON with title, body and evidence citations.", "steps": 4 },
    "title": { "disable": true },
    "summary": { "disable": true },
    "compaction": { "disable": true },
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "provider": {
    "probe": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Offline fixture",
      "options": { "baseURL": "http://127.0.0.1:0/v1", "apiKey": "offline-fixture-only" },
      "models": { "fixture": { "name": "Fixture", "limit": { "context": 32768, "output": 4096 }, "cost": { "input": 0, "output": 0 } } }
    }
  },
  "mcp": { "corpus": { "type": "remote", "url": "http://127.0.0.1:0/mcp", "enabled": true, "oauth": false } }
}
