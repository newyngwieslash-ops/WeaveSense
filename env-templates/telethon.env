MINIO_ACCESS_KEY=loom
MINIO_SECRET_KEY=<GEN>
MINIO_BUCKET=loom
MINIO_PUBLIC_URL=http://127.0.0.1:9000/loom
# Optional credentials; absent credentials keep only public-channel fallback available.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional string session; otherwise login.py writes the named-volume session.
TELEGRAM_SESSION=
TELETHON_CONCURRENCY=3
# Same independently generated token as app.env; absent disables attachments only.
TELEGRAM_MEDIA_TOKEN=
