FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0
RUN go build -o /out/opencode-worker ./cmd/opencode-worker

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/opencode-worker /app/opencode-worker
USER nonroot
ENTRYPOINT ["/app/opencode-worker"]
