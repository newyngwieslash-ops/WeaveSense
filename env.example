# Copy values into the shell or a private env file before `docker compose up`.
# Do not commit real secrets.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional. Prefer `docker compose run --rm -it telethon python login.py`
TELEGRAM_SESSION=

MINIO_ROOT_USER=loom
MINIO_ROOT_PASSWORD=loom-secret-change-me
MINIO_BUCKET=loom
# Browser-reachable MinIO prefix (host, not the docker hostname)
MINIO_PUBLIC_URL=http://127.0.0.1:9000/loom

# Optional. Enables LLM / OCR / ASR inside the app container.
XAI_API_KEY=

# AI engine. legacy = in-process xAI chat; eino = internal Go agent service.
# Do not set eino until AGENT_SERVICE_URL and AGENT_SERVICE_TOKEN are set.
AI_ENGINE=legacy
AGENT_SERVICE_URL=http://agent:8791
# Independent service token. Do not reuse CRON_SECRET.
AGENT_SERVICE_TOKEN=
# Independent data-API token for Go -> app tool calls.
AGENT_DATA_TOKEN=
AGENT_DATA_URL=http://app:8080/api/internal/agent-data
AGENT_MODEL_BASE_URL=https://api.x.ai/v1
AGENT_MODEL_NAME=grok-4.5
# May be mapped from XAI_API_KEY in Compose.
AGENT_MODEL_API_KEY=
AGENT_MAX_CONCURRENT_RUNS=2
# Empty means no MCP. Copy workers/agent/config/mcp.example.json and enable explicitly.
AGENT_MCP_CONFIG=

# How many due sources+keywords the control plane scans per tick
TICK_LIMIT=20
# true = also run OCR/ASR on ingest (uses xAI quota)
EXTRACT_AUTO=false
# true = enqueue bounded automatic item analysis. Independent of EXTRACT_AUTO.
AUTO_ANALYZE=false
AUTO_ANALYZE_DAILY_LIMIT=20
AUTO_ANALYZE_DAILY_BUDGET_RMB=20
AUTO_ANALYZE_PRICE_VERSION=v1
AUTO_ANALYZE_WORST_COST_RMB=1
TELETHON_CONCURRENCY=3

# WeChat primary-feed gateway. Keep the token private and list only trusted
# WeWe/RSSHub hostnames (comma-separated, without scheme or port).
WECHAT_GATEWAY_URL=http://wechat-gateway:8790
WECHAT_GATEWAY_TOKEN=
WECHAT_PRIMARY_ALLOWED_HOSTS=

# Always-on Compose scheduler. Generate a private random secret.
CRON_SECRET=
CRON_INTERVAL_MS=1800000
CRON_TICK_LIMIT=200

# Optional paid WeChat fallback. The daily budget is a hard ceiling.
DAJIALA_KEY=
DAJIALA_VERIFYCODE=
DAJIALA_BASE_URL=https://www.dajiala.com/fbmain/monitor/v3
DAJIALA_DAILY_BUDGET_RMB=20
DAJIALA_DAILY_CALL_LIMIT=250
